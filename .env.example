# Copy to .env (never commit .env). All secrets come from here or a vault.

# Read-only Toucan service account (password-only auth mode; no OTP/TOTP)
TOUCAN_USERNAME=
TOUCAN_PASSWORD=
# Optional overrides (defaults are the UAT URLs from the host's environment bundle)
# TOUCAN_UAM_URL=https://ops-uam.testtoucanpay.in
# TOUCAN_CANDS_URL=https://ops-cands.testtoucanpay.in
# TOUCAN_ACCOUNTING_URL=https://ops-accounting.testtoucanpay.in
TOUCAN_PAGE_SIZE=100
TOUCAN_MAX_PAGES=200

DB_PASSWORD=

# Dashboard logins (VIEWER read/export, OPERATOR + runs and mapping confirmation, ADMIN + audit log)
DASH_VIEWER_PASSWORD=
DASH_OPERATOR_PASSWORD=
DASH_ADMIN_PASSWORD=

# Scheduler (cron in Asia/Kolkata): off until credentials are in place
MONITOR_SCHEDULE_ENABLED=false
# MONITOR_CRON_TRANSACTIONS=0 */15 * * * *
# MONITOR_CRON_FILES=0 5 * * * *
# MONITOR_CRON_LEDGER=0 30 6 * * *
MONITOR_WINDOW_DAYS=7
# Per-run look-up caps (UAT answers in ~8-11 s per call)
MONITOR_RRN_LOOKUPS=100
MONITOR_PAYMENT_LOOKUPS=50
